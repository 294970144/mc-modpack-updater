<?xml version="1.0" encoding="utf-8"?>
<AssemblyManifest Version="1.0.0.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <AssemblyIdentity Version="1.0.0.0" Name="McUpdater.app" />

  <Application xmlns="urn:schemas-microsoft-com:asm.v3">
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="我的世界更新助手"
        Description="Minecraft 整合包增量更新工具"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Application>

  <Extensions>
    <!-- 全局用户配置：%LOCALAPPDATA%\McUpdater\settings.json（本次范围未用到，保留位） -->
    <Extension Category="windows.appService">
      <AppService Name="McUpdater" />
    </Extension>
  </Extensions>
</AssemblyManifest>
