<!--
  ============================================================================
  PixelBackground.xaml — 像素生态背景层（飘动云朵 + 落树叶）

  移植自 public/css/main.css 的 .bg-scene（index.html 第 13~23 行的 3 云 + 6 叶）。

  【为什么用 Canvas + Path 而不是 Image】
  CSS 版云朵/树叶是 box-shadow 堆出来的像素画。本项目（M0 决策）已决定
  背景动画走 UIElement.StartAnimation 驱动 Composition —— 那要求元素有
  可动画的 Translation/Offset 属性，Image 也能做，但云朵形状需要 9 个圆角矩形
  叠出像素轮廓，用 Canvas 画 Path 反而更直接，且不依赖任何外部 PNG 素材
  （本项目不引第三方资源，图标也是 make_assets.py 手写的）。

  【性能】
  M0 探针③ 实测：3 个云 2 秒位移 1064px，UI 线程 DispatcherTimer 抖动恒定
  33.9ms 不增长 —— 动画完全跑在 compositor 线程，UI 线程零占用。
  所以这里放 60 个元素也安全，与后台 diff 的 CRC32 计算不争线程。

  【裁剪】
  WinUI 3 没有 ClipToBounds 属性（面板级也没有）。靠 Canvas.Clip 的
  RectangleGeometry 实现，宽度由代码跟随窗口更新（见 PixelBackground.xaml.cs）。
  ============================================================================
-->
<UserControl
    x:Class="McUpdater.Backgrounds.PixelBackground"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    UseSystemFocusVisuals="False">

  <UserControl.Resources>
    <!-- 云朵：三段圆角矩形叠出像素轮廓，对应 CSS 的 box-shadow 组合 -->
    <CornerRadius x:Key="CloudCapRadius">18</CornerRadius>
    <CornerRadius x:Key="CloudBodyRadius">26</CornerRadius>

    <!-- 树叶：三种尺寸的小方块群，对应 CSS 的 .leaf-1..6 -->
    <SolidColorBrush x:Key="BrushLeafA" Color="#66A8C86A" />
    <SolidColorBrush x:Key="BrushLeafB" Color="#4D8B6444" />
    <SolidColorBrush x:Key="BrushLeafC" Color="#59E0A83C" />
  </UserControl.Resources>

  <Canvas x:Name="SceneCanvas" Background="Transparent">
    <Canvas.Clip>
      <RectangleGeometry x:Name="SceneClip" Rect="0,0,1200,600" />
    </Canvas.Clip>

    <!-- ==================================================================
         【Canvas.Left / Canvas.Top 与 Composition Translation 的分工】
         Translation 是**渲染期 post-layout 的叠加位移**，会加在布局位置之上：

             实际屏幕位置 = Canvas 布局位置 + Translation

         所以两轴必须分给不同机制管，不能都写进 Canvas 属性 —— 否则动画
         数值和布局数值叠在一起，起点会莫名偏出去。

             云：只做水平漂移（X 动，Y 不动）
                → Canvas.Left="0"（位移全交给 Translation.X）
                → Canvas.Top 保留（静止高度，Y 不参与动画）
             叶：只做垂直下落（Y 动，X 只摆动）
                → Canvas.Top="0"（下落全交给 Translation.Y）
                → Canvas.Left 保留（静止 X 基准，仅叠加摆幅）

         【为什么不干脆都用 Canvas 属性】
         Composition 动画跑 compositor 线程，零 UI 线程占用（M0 探针③ 实测）。
         用 Margin/Canvas 属性做动画会触发每帧重排，且与后台 diff 抢线程。
         ================================================================== -->

    <!-- ===== 云朵（3 朵，横向匀速飘过，各自周期不同形成视差）===== -->
    <!-- 云 1：大，速度最快 -->
    <Canvas x:Name="Cloud1" Canvas.Left="0" Canvas.Top="90">
      <Grid Height="70">
        <Border Width="120" Height="44" VerticalAlignment="Bottom"
                Background="{StaticResource BrushCard}"
                CornerRadius="{StaticResource CloudBodyRadius}" />
        <Border Width="86" Height="52" HorizontalAlignment="Left"
                VerticalAlignment="Bottom" Margin="18,0,0,0"
                Background="{StaticResource BrushCard}"
                CornerRadius="{StaticResource CloudCapRadius}" />
        <Border Width="70" Height="36" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="0,0,14,0"
                Background="{StaticResource BrushCard2}"
                CornerRadius="{StaticResource CloudCapRadius}" />
      </Grid>
    </Canvas>

    <!-- 云 2：中，速度居中 -->
    <Canvas x:Name="Cloud2" Canvas.Left="0" Canvas.Top="300">
      <Grid Height="54">
        <Border Width="96" Height="34" VerticalAlignment="Bottom"
                Background="{StaticResource BrushWheatL}"
                CornerRadius="{StaticResource CloudBodyRadius}" />
        <Border Width="64" Height="40" HorizontalAlignment="Left"
                VerticalAlignment="Bottom" Margin="14,0,0,0"
                Background="{StaticResource BrushWheatL}"
                CornerRadius="{StaticResource CloudCapRadius}" />
      </Grid>
    </Canvas>

    <!-- 云 3：小，速度最慢 -->
    <Canvas x:Name="Cloud3" Canvas.Left="0" Canvas.Top="520">
      <Grid Height="40">
        <Border Width="74" Height="26" VerticalAlignment="Bottom"
                Background="{StaticResource BrushCard}"
                CornerRadius="{StaticResource CloudBodyRadius}" />
        <Border Width="50" Height="30" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="0,0,10,0"
                Background="{StaticResource BrushCard2}"
                CornerRadius="{StaticResource CloudCapRadius}" />
      </Grid>
    </Canvas>

    <!-- ===== 树叶（6 片，垂直缓落 + 轻微横向摆动，对应 CSS .leaf-1..6）===== -->
    <!-- Canvas.Top="0"：下落起点/终点由 Translation.Y 决定。
         Canvas.Left 各不相同：横向散布 + 摆幅的基准位置，由 Translation.X 叠加摆动。 -->
    <Canvas x:Name="Leaf1" Canvas.Left="140" Canvas.Top="0">
      <Border Width="12" Height="12" Background="{StaticResource BrushLeafA}"
              CornerRadius="2" />
    </Canvas>
    <Canvas x:Name="Leaf2" Canvas.Left="420" Canvas.Top="0">
      <StackPanel>
        <Border Width="9" Height="9" Background="{StaticResource BrushLeafB}"
                CornerRadius="2" HorizontalAlignment="Left" />
        <Border Width="7" Height="7" Background="{StaticResource BrushLeafC}"
                CornerRadius="2" HorizontalAlignment="Left" Margin="5,0,0,0" />
      </StackPanel>
    </Canvas>
    <Canvas x:Name="Leaf3" Canvas.Left="760" Canvas.Top="0">
      <Border Width="14" Height="11" Background="{StaticResource BrushLeafC}"
              CornerRadius="3" />
    </Canvas>
    <Canvas x:Name="Leaf4" Canvas.Left="1080" Canvas.Top="0">
      <Border Width="10" Height="10" Background="{StaticResource BrushLeafA}"
              CornerRadius="2" />
    </Canvas>
    <Canvas x:Name="Leaf5" Canvas.Left="640" Canvas.Top="0">
      <Border Width="11" Height="11" Background="{StaticResource BrushLeafB}"
              CornerRadius="2" />
    </Canvas>
    <Canvas x:Name="Leaf6" Canvas.Left="300" Canvas.Top="0">
      <StackPanel Orientation="Horizontal">
        <Border Width="8" Height="8" Background="{StaticResource BrushLeafA}"
                CornerRadius="2" />
        <Border Width="6" Height="6" Background="{StaticResource BrushLeafC}"
                CornerRadius="2" Margin="3,0,0,0" />
      </StackPanel>
    </Canvas>
  </Canvas>
</UserControl>