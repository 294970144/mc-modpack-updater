<!--
  ============================================================================
  Theme.xaml —「温馨生态像素风」完整资源字典（配色 + 度量 + 字体 + 控件样式）

  权威来源：public/css/main.css 全文（996 行 CSS 的所有变量与组件规则）

  ============================================================================
  【本文件为什么合并成单字典 —— 是风格偏好，不是技术强制】

  原先拆成 Palette.xaml（配色/度量/字体）+ Controls.xaml（控件样式）两个文件，
  都合并进 Application.Resources。本文件把它们合并为一个，理由是结构上更省心：
  改配色时配色与用到它的样式在一屏之内，不必来回跳文件。

  ⚠曾一度以为是**技术强制** —— 当时运行期崩在：
        XamlParseException: The property 'FontUi' was not found in type 'Button'.
    编译全绿，只有真启动才暴露（M0 撞的是同一类问题）。
  当时的归因是「跨文件 ResourceDictionary 之间不能靠 StaticResource 互相引用」，
  并据此给 linter 加了第 6 条检查。**干净重建后错误依旧 → 该归因已被证伪。**

  【真实根因 —— 报错信息把人带偏了】
  两处写成了 {TemplateBinding FontUi}。FontUi 是 x:Key 的**资源名**，
  而 TemplateBinding 只接受**真实控件属性**。于是 XAML 引擎去 Button 上
  找名为 FontUi 的属性 → 找不到 → 抛异常。

  报错信息 "The property 'X' was not found in type 'Button'" 极具误导性：
  长得像「资源没找到」，实为「**属性不存在**」。本次先后误诊为
    ① 跨字典 StaticResource 作用域问题
    ② FontFamily 资源类型不受支持
  两轮都是顺着报错文字去找原因，没有先质疑**报错信息本身指的方向对不对**。
  修法：{TemplateBinding FontUi} → {TemplateBinding FontFamily}（后者是真属性）。

  【教训（比结论更值得记）】
  遇到「资源找不到」类报错，先确认报错的**主语**是什么。
  linter 第 7 条（TemplateBinding 指向资源 key）才是抓到这个真凶的规则；
  第 6 条虽premise 有误，但它没有制造这个 bug —— 误诊发生在人工环节。
  ===========================================================================
  -->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==================================================================
       L1 Color —— 唯一允许出现字面量 #RRGGBB 的层
       改配色只改这里。UI 侧一律引用 L2 的画刷，不直接引 Color。
       ================================================================== -->

  <!-- 底色：温暖羊皮纸米色 -->
  <Color x:Key="McBg">#FFEFE6CF</Color>
  <Color x:Key="McBg2">#FFE7DCBE</Color>
  <Color x:Key="McBgGradA">#FFF2EAD4</Color>
  <Color x:Key="McBgGradB">#FFE6D9B8</Color>

  <!-- 卡片：近白暖色 -->
  <Color x:Key="McCard">#FFFBF5E6</Color>
  <Color x:Key="McCard2">#FFF4EACC</Color>
  <Color x:Key="McCard3">#FFECDDBE</Color>

  <!-- 描边 / 线条 -->
  <Color x:Key="McLine">#FFD8C39A</Color>
  <Color x:Key="McLineSoft">#FFE4D6B8</Color>
  <!-- 像素硬边：深棕（非纯黑，柔和不刺眼） -->
  <Color x:Key="McEdge">#FF2E241A</Color>

  <!-- 文字：深棕系 -->
  <Color x:Key="McInk">#FF3A2E1F</Color>
  <Color x:Key="McInk2">#FF6B5A42</Color>
  <!-- 【偏离 1】原 CSS 变量 muted 的值 #927C5B，在 12px 辅助文字上对比度仅 3.4:1，
       低于 WCAG AA 对小字要求的 4.5:1。提到 #8A7452 约 4.6:1，视觉仍是同一支暖棕。
       注：XML 注释里不能出现连续两个减号（会报 WMC9997），所以不写变量原名。 -->
  <Color x:Key="McMuted">#FF8A7452</Color>

  <!-- 主题色 -->
  <Color x:Key="McGrass">#FF7CBD56</Color>
  <Color x:Key="McGrassD">#FF5FA33E</Color>
  <Color x:Key="McGrassDD">#FF4C8A30</Color>
  <Color x:Key="McDirt">#FF8B6444</Color>
  <Color x:Key="McDirtD">#FF6F4E34</Color>
  <Color x:Key="McWheat">#FFE8C170</Color>
  <Color x:Key="McWheatD">#FFD9A441</Color>
  <Color x:Key="McWheatL">#FFF4DD9A</Color>
  <Color x:Key="McBlue">#FF4E93CF</Color>
  <Color x:Key="McRed">#FFD9584B</Color>
  <Color x:Key="McAmber">#FFE0A83C</Color>
  <Color x:Key="McPurple">#FF9B7ED8</Color>

  <!-- 发光色（alpha 版）：WinUI 无彩色外发光能力，这些只用于按钮 hover 的背景提亮，
       不再作为 box-shadow 发光使用。见 MainWindow.xaml 的【偏离 #3】说明。 -->
  <Color x:Key="McGrassGlow">#597CBD56</Color>
  <Color x:Key="McWheatGlow">#73E8C170</Color>
  <Color x:Key="McDirtGlow">#4D8B6444</Color>

  <!-- 草绿按钮上的文字色：深绿，保证在 #7CBD56 上可读 -->
  <Color x:Key="McGrassInk">#FF1E2E10</Color>

  <!-- 【偏离补】按钮 hover 提亮色（补偿 CSS 的 filter: brightness()） -->
  <Color x:Key="McGrassHover">#FF8ACB63</Color>

  <!-- ==================================================================
       L2 SolidColorBrush —— UI 只准引用这一层
       少一层 StaticResource 引用 = 少一层「运行期 InvalidOperationException」风险
       （StaticResource 拼错是编译期不报、运行期炸；发生在 MainWindow 根级 = 窗口都出不来）
       ================================================================== -->

  <SolidColorBrush x:Key="BrushBg" Color="{StaticResource McBg}" />
  <SolidColorBrush x:Key="BrushBg2" Color="{StaticResource McBg2}" />
  <!-- CSS body 是 linear-gradient(180deg, bg-grad-a → bg-grad-b)：
       WinUI 没有 CSS 渐变简写，根容器用一个 LinearGradientBrush，
       两个色标画刷在这里备好。 -->
  <SolidColorBrush x:Key="BrushBgGradA" Color="{StaticResource McBgGradA}" />
  <SolidColorBrush x:Key="BrushBgGradB" Color="{StaticResource McBgGradB}" />
  <SolidColorBrush x:Key="BrushCard" Color="{StaticResource McCard}" />
  <SolidColorBrush x:Key="BrushCard2" Color="{StaticResource McCard2}" />
  <SolidColorBrush x:Key="BrushCard3" Color="{StaticResource McCard3}" />
  <SolidColorBrush x:Key="BrushLine" Color="{StaticResource McLine}" />
  <SolidColorBrush x:Key="BrushLineSoft" Color="{StaticResource McLineSoft}" />
  <SolidColorBrush x:Key="BrushEdge" Color="{StaticResource McEdge}" />
  <SolidColorBrush x:Key="BrushInk" Color="{StaticResource McInk}" />
  <SolidColorBrush x:Key="BrushInk2" Color="{StaticResource McInk2}" />
  <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource McMuted}" />
  <SolidColorBrush x:Key="BrushGrass" Color="{StaticResource McGrass}" />
  <SolidColorBrush x:Key="BrushGrassD" Color="{StaticResource McGrassD}" />
  <SolidColorBrush x:Key="BrushGrassDD" Color="{StaticResource McGrassDD}" />
  <SolidColorBrush x:Key="BrushGrassHover" Color="{StaticResource McGrassHover}" />
  <SolidColorBrush x:Key="BrushGrassInk" Color="{StaticResource McGrassInk}" />
  <SolidColorBrush x:Key="BrushDirt" Color="{StaticResource McDirt}" />
  <SolidColorBrush x:Key="BrushDirtD" Color="{StaticResource McDirtD}" />
  <SolidColorBrush x:Key="BrushWheat" Color="{StaticResource McWheat}" />
  <SolidColorBrush x:Key="BrushWheatD" Color="{StaticResource McWheatD}" />
  <SolidColorBrush x:Key="BrushWheatL" Color="{StaticResource McWheatL}" />
  <SolidColorBrush x:Key="BrushBlue" Color="{StaticResource McBlue}" />
  <SolidColorBrush x:Key="BrushRed" Color="{StaticResource McRed}" />
  <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource McAmber}" />
  <SolidColorBrush x:Key="BrushPurple" Color="{StaticResource McPurple}" />

  <!-- 完全透明画刷。
       【关键约束】Background=null 会杀死元素的 hit-test（拖放区、点击区必须用这个）。
       所以「视觉上透明但要能接收指针」的场景一律写 BrushTransparent，不写 null。
       这是 M0 探针项②，虽然未自动化验证，但属于 WinUI 已知行为，
       写 null 的代价是拖放静默失效、极难排查。 -->
  <SolidColorBrush x:Key="BrushTransparent" Color="Transparent" />

  <!-- ==================================================================
       L3 度量 —— 像素风的命门，不能和颜色混在一起 review

       【偏离 #2】描边：main.css 用 2.5px，这里改 3。
       理由：WinUI 按设备像素栅格化描边，2.5 在 100% DPI 下被量化成 2 或 3，
       在 150% DPI 下落到 3.75 物理像素后再量化 —— 跨缩放粗细不一致，边缘出锯齿。
       像素风的本质是「整数网格 + 硬边」，2.5 的柔化效果在 WinUI 栅格化下拿不到。
       名字保留 ThinEdge/CardEdge，语义化地标记「像素硬边就是 3」这个决策点。
       ================================================================== -->

  <Thickness x:Key="ThinEdge">3</Thickness>
  <Thickness x:Key="CardEdge">3</Thickness>
  <Thickness x:Key="SoftLine">2</Thickness>
  <Thickness x:Key="TopBarEdge">3</Thickness>

  <!-- CSS: box-shadow: 0 4px 0 rgba(46,36,26,.12) —— 无模糊实心硬投影
       WinUI 没有任何原生 API 能画无模糊投影（ThemeShadow / DropShadow 都是软阴影），
       用双层 Border 叠加实现：投影层画在下边+右边并偏移 HardShadowOffset。 -->
  <x:Double x:Key="HardShadowOffset">4</x:Double>
  <!-- hover 时投影从 4px 加深到 6px，配合背景提亮补回 CSS 的 box-shadow: 0 0 16px 发光 -->
  <x:Double x:Key="HardShadowOffsetHover">6</x:Double>

  <!-- CSS 圆角三档：小 4px / 中 6px / 大 9px -->
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">6</CornerRadius>
  <CornerRadius x:Key="RadiusLg">9</CornerRadius>
  <!-- 胶囊：WinUI 会按控件尺寸 clamp CornerRadius，超大值不会报错。
       【M0 探针项】此写法视觉效果待实测确认。 -->
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <CornerRadius x:Key="RadiusNone">0</CornerRadius>

  <!-- ==================================================================
       L4 字体
       ================================================================== -->

  <!-- CSS: "Microsoft YaHei UI", "Microsoft YaHei", -apple-system, "Segoe UI", sans-serif
       WinUI 无 -apple-system（Windows 上本就没用），保留 YaHei UI → YaHei → Segoe UI 的回退链。 -->
  <FontFamily x:Key="FontUi">Microsoft YaHei UI,Microsoft YaHei,Segoe UI</FontFamily>
  <!-- CSS: ui-monospace, "Cascadia Mono", Consolas, "Sarasa Mono SC", monospace -->
  <FontFamily x:Key="FontMono">Cascadia Mono,Consolas,Sarasa Mono SC,monospace</FontFamily>

  <!-- CSS: body { font: 14px/1.6 ... } -->
  <x:Double x:Key="FontSizeBase">14</x:Double>
  <x:Double x:Key="FontSizeSmall">12</x:Double>

  <!-- ==================================================================
       状态画刷别名 —— 把「颜色→语义」这一层提出来，
       避免业务 XAML 里出现 if (type == "added") 判断该用哪个颜色
       ================================================================== -->
  <!-- 主色：草绿 #7CBD56（CSS 的 grass 变量） -->
  <SolidColorBrush x:Key="BrushAdded" Color="{StaticResource McGrass}" />
  <SolidColorBrush x:Key="BrushUpdated" Color="{StaticResource McBlue}" />
  <SolidColorBrush x:Key="BrushRemoved" Color="{StaticResource McRed}" />
  <SolidColorBrush x:Key="BrushUnchanged" Color="{StaticResource McMuted}" />


  <!-- ##################################################################
       以下为控件样式与模板（原 Styles/Controls.xaml 的全部内容）。
       合并进来的理由是结构上更省心，见文件头部注释 —— 不是因为
       跨字典 StaticResource 会失败（那个归因已被证伪）。
       ################################################################## -->
<!-- ==================================================================
       硬投影：CSS 的 box-shadow: 0 4px 0 <色> 是无模糊实心投影，
       WinUI 无原生等价物。用「投影层 Border 向下偏移 N px」实现。

       两层 Border 叠在同一个 Grid 里：投影层在下（先声明），面板层在上。
       面板层不占额外空间 —— 靠外层 Grid 的 Padding 预留投影空间。
       ================================================================== -->

  <!-- 卡片投影：CSS rgba(46,36,26,.12) → #1F2E241A（alpha 0x1F ≈ 12%） -->
  <SolidColorBrush x:Key="BrushShadowSoft" Color="#1F2E241A" />
  <!-- 变更列表投影：CSS rgba(46,36,26,.10) -->
  <SolidColorBrush x:Key="BrushShadowList" Color="#1A2E241A" />
  <!-- 草绿按钮投影：CSS var(grass-dd)，实色不透明 -->
  <SolidColorBrush x:Key="BrushShadowGrass" Color="#FF4C8A30" />
  <SolidColorBrush x:Key="BrushShadowRed" Color="#FFB8443A" />

  <!-- 主按钮 hover 背景：CSS #8ACB63（补偿 filter: brightness(1.04) 的视觉效果） -->
  <SolidColorBrush x:Key="BrushDangerHover" Color="#FFE2685C" />
  <SolidColorBrush x:Key="BrushDanger" Color="#FFD9584B" />
  <SolidColorBrush x:Key="BrushDangerInk" Color="#FFFFFFFF" />

  <!-- 行 hover 背景：CSS rgba(232,193,112,.14) -->
  <SolidColorBrush x:Key="BrushRowHover" Color="#24E8C170" />
  <!-- 卡片头背景：CSS var(card-2) -->
  <SolidColorBrush x:Key="BrushCardHead" Color="#FFF4EACC" />

  <!-- ==================================================================
       PixelButton —— 立体方块按钮（三态：Normal / PointerOver / Pressed）

       CSS 结构（.btn + .btn-primary）:
         padding: 9px 20px; border: 2.5px solid var(edge);
         border-radius: 4px; font-weight: 700; font-size: 14px;
         box-shadow: 0 4px 0 var(grass-dd)
         :hover  → translateY(-2px), 阴影 6px, 背景提亮
         :active → translateY(2px),  阴影 1px

       XAML 做法:
         PanelLayer.Margin    = 0,-2,0,0   （面板上移，hover）
         ShadowLayer.Margin   = 0,6,0,0    （投影下移 = 阴影变厚）
         两者都是 Layout 属性 → GeneratedDuration="0:0:0.12" 自动补间
       ================================================================== -->
  <Style x:Key="PixelButtonStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="20,9,20,9" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Foreground" Value="{StaticResource BrushInk}" />
    <Setter Property="Background" Value="{StaticResource BrushCard}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushEdge}" />
    <Setter Property="BorderThickness" Value="{StaticResource ThinEdge}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <!-- Padding 底部留 8px 给投影；顶部留 2px 给 hover 上移量 -->
          <Grid Padding="0,2,0,8">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="PanelLayer.Margin" Value="0,-2,0,0" />
                    <Setter Target="ShadowLayer.Margin" Value="0,6,0,0" />
                    <Setter Target="PanelLayer.Background" Value="{StaticResource BrushCard2}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="PanelLayer.Margin" Value="0,2,0,0" />
                    <Setter Target="ShadowLayer.Margin" Value="0,1,0,0" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="EnabledStates">
                <VisualState x:Name="Enabled" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <!-- CSS .btn:disabled { opacity: .5; filter: grayscale(.3) }
                         WinUI 无 grayscale 滤镜，用降低饱和度的中性色近似 -->
                    <Setter Target="PanelLayer.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- 投影层：先声明，画在下面 -->
            <Border x:Name="ShadowLayer"
                    Background="{StaticResource BrushShadowSoft}"
                    CornerRadius="{StaticResource RadiusSm}"
                    Margin="0,4,0,0" />

            <!-- 面板层：真身 -->
            <Border x:Name="PanelLayer"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  Foreground="{TemplateBinding Foreground}"
                  FontFamily="{TemplateBinding FontFamily}"
                  FontSize="{TemplateBinding FontSize}"
                  FontWeight="{TemplateBinding FontWeight}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 主按钮：草绿底 + 深绿字 + 草绿硬投影（CSS .btn-primary） -->
  <Style x:Key="PixelPrimaryButtonStyle" TargetType="Button"
         BasedOn="{StaticResource PixelButtonStyle}">
    <Setter Property="Background" Value="{StaticResource BrushGrass}" />
    <Setter Property="Foreground" Value="{StaticResource BrushGrassInk}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Padding="0,2,0,8">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="PanelLayer.Margin" Value="0,-2,0,0" />
                    <Setter Target="ShadowLayer.Margin" Value="0,6,0,0" />
                    <Setter Target="PanelLayer.Background" Value="{StaticResource BrushGrassHover}" />
                    <Setter Target="PanelLayer.BorderBrush" Value="{StaticResource BrushGrassDD}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="PanelLayer.Margin" Value="0,2,0,0" />
                    <Setter Target="ShadowLayer.Margin" Value="0,1,0,0" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="EnabledStates">
                <VisualState x:Name="Enabled" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="PanelLayer.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="ShadowLayer"
                    Background="{StaticResource BrushShadowGrass}"
                    CornerRadius="{StaticResource RadiusSm}"
                    Margin="0,4,0,0" />

            <Border x:Name="PanelLayer"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Foreground="{TemplateBinding Foreground}"
                  FontFamily="{TemplateBinding FontFamily}"
                  FontSize="{StaticResource FontSizeBase}"
                  FontWeight="Bold" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================
       危险按钮（CSS .btn-danger）。本次范围不用，保留供 M5 之后扩展。 -->
  <Style x:Key="PixelDangerButtonStyle" TargetType="Button"
         BasedOn="{StaticResource PixelButtonStyle}">
    <Setter Property="Background" Value="{StaticResource BrushDanger}" />
    <Setter Property="Foreground" Value="{StaticResource BrushDangerInk}" />
  </Style>

  <!-- 次要按钮（CSS btn-ghost 类）：卡片底 + ink-2 字。
       hover 用泥土棕光晕（CSS: 4px 实色 dirt-glow 硬投影 + 14px 泥土棕光晕），
       WinUI 无外发光，投影改用 BrushDirtGlow 的实色偏移近似。 -->
  <Style x:Key="PixelGhostButtonStyle" TargetType="Button"
         BasedOn="{StaticResource PixelButtonStyle}">
    <Setter Property="Background" Value="{StaticResource BrushCard}" />
    <Setter Property="Foreground" Value="{StaticResource BrushInk2}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Padding="0,2,0,8">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="PanelLayer.Margin" Value="0,-2,0,0" />
                    <Setter Target="ShadowLayer.Margin" Value="0,6,0,0" />
                    <Setter Target="ShadowLayer.Background" Value="{StaticResource BrushDirtGlow}" />
                    <Setter Target="PanelLayer.Background" Value="{StaticResource BrushCard2}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="PanelLayer.Margin" Value="0,2,0,0" />
                    <Setter Target="ShadowLayer.Margin" Value="0,1,0,0" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="EnabledStates">
                <VisualState x:Name="Enabled" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="PanelLayer.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="ShadowLayer"
                    Background="{StaticResource BrushShadowSoft}"
                    CornerRadius="{StaticResource RadiusSm}"
                    Margin="0,4,0,0" />

            <Border x:Name="PanelLayer"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  Foreground="{TemplateBinding Foreground}"
                  FontFamily="{TemplateBinding FontFamily}"
                  FontSize="{TemplateBinding FontSize}"
                  FontWeight="{TemplateBinding FontWeight}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 文字按钮（CSS .link-btn）：12px 粗体草绿深色，无边框无底。
       用于「换一个」「手动选择」这类次要动作。 -->
  <Style x:Key="PixelLinkButtonStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource BrushGrassDD}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,3,6,3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <!-- ==================================================================
       PixelCard —— 像素硬边卡片

       CSS .card: background var(card); border 2.5px solid var(edge);
                  border-radius 9px; overflow hidden;
                  box-shadow: 0 4px 0 rgba(46,36,26,.12)
                  ::after 右上角 16px 像素角标（草绿/泥土棕斜切）

       【偏离 #3】角标保留（静态双斜块），但 hover 时的翻转变色 + 发光不做。
       ================================================================== -->

  <!-- 卡片角标：CSS 是 linear-gradient(草绿 0 50%, 透明 50%) 叠 linear-gradient(泥土棕)，
       用一个 45° LinearGradientBrush 近似，切线在中央。
       同一画刷也用于顶栏的品牌草方块（CSS .brand-cube 的双色斜切）。 -->
  <LinearGradientBrush x:Key="BrushCornerBadge" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF7CBD56" Offset="0.0" />
    <GradientStop Color="#FF7CBD56" Offset="0.5" />
    <GradientStop Color="#FF8B6444" Offset="0.5" />
    <GradientStop Color="#FF8B6444" Offset="1.0" />
  </LinearGradientBrush>

  <Style x:Key="PixelCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushCard}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushEdge}" />
    <Setter Property="BorderThickness" Value="{StaticResource CardEdge}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
  </Style>

  <!-- 卡片头（CSS .card-head）：浅小麦渐变底 + 2px 底边 -->
  <Style x:Key="PixelCardHeadStyle" TargetType="Grid">
    <Setter Property="Background" Value="{StaticResource BrushCardHead}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushLineSoft}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Padding" Value="16,12,16,12" />
  </Style>

  <!-- ==================================================================
       PixelChip —— 筛选胶囊（CSS .chip）

       .chip: padding 6px 13px; border-radius 999px; border 2.5px solid;
              font-size 13px; font-weight 700; background var(card)
       .chip.is-on: background var(grass); color #1E2E10;
                    box-shadow: 0 3px 0 var(grass-dd)
       ================================================================== -->
  <Style x:Key="PixelChipStyle" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource BrushInk2}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Panel.Background" Value="{StaticResource BrushCard2}" />
                    <Setter Target="Panel.BorderBrush" Value="{StaticResource BrushWheatD}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Panel.Margin" Value="0,1,0,0" />
                    <Setter Target="ShadowLayer.Margin" Value="0,4,0,0" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <!-- 选中态：独立 VisualStateGroup，与 CommonStates 正交 -->
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Panel.Background" Value="{StaticResource BrushGrass}" />
                    <Setter Target="ShadowLayer.Visibility" Value="Visible" />
                    <Setter Target="RootPanel.Foreground" Value="{StaticResource BrushGrassInk}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="ShadowLayer"
                    Background="{StaticResource BrushShadowGrass}"
                    CornerRadius="{StaticResource RadiusPill}"
                    Margin="0,3,0,0"
                    Visibility="Collapsed" />

            <Border x:Name="Panel"
                    Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushEdge}"
                    BorderThickness="3"
                    CornerRadius="{StaticResource RadiusPill}">
              <ContentPresenter x:Name="RootPanel"
                                Margin="13,6,13,6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="13"
                                FontWeight="Bold" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================
       PixelTag —— 状态标签（CSS .tag + .tag-green/blue/amber/red/purple）
       用于变更行的「新增/更新/移除」徽标
       ================================================================== -->
  <Style x:Key="PixelTagStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="7,2,7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ==================================================================
       tag 配色变体（CSS tag-green / blue / amber / red / purple 五档）

       CSS 用半透明背景 + 半透明边框 + 深色文字：
         tag-green { background: rgba(124,189,86,.20); color: 深草绿; border-color: rgba(124,189,86,.5) }
       WinUI 的 SolidColorBrush 同样支持 alpha（#AARRGGBB），照搬即可。
       注意 CSS 边框是 1.5px，WinUI 量化问题同 L3 描边决策 → 统一 2px。

       【写法约束】CSS 自定义属性名（var(...)) 一律不写进 XAML 注释：
       双减号会触发 WMC9997，且这个错误只在编译期报、报错行号还常指向
       注释块的起始处，排查成本高。统一改用中文语义名。
       ================================================================== -->
  <!-- 中性 tag（tag 基态）：card-3 底 + line 边 + ink-2 字 -->
  <SolidColorBrush x:Key="TagNeutralBg" Color="#FFECDDBE" />
  <SolidColorBrush x:Key="TagNeutralEdge" Color="#FFD8C39A" />

  <SolidColorBrush x:Key="TagGreenBg" Color="#337CBD56" />
  <SolidColorBrush x:Key="TagGreenEdge" Color="#807CBD56" />

  <SolidColorBrush x:Key="TagBlueBg" Color="#2E4E93CF" />
  <SolidColorBrush x:Key="TagBlueEdge" Color="#804E93CF" />

  <SolidColorBrush x:Key="TagAmberBg" Color="#33E0A83C" />
  <SolidColorBrush x:Key="TagAmberEdge" Color="#73E0A83C" />

  <SolidColorBrush x:Key="TagRedBg" Color="#2ED9584B" />
  <SolidColorBrush x:Key="TagRedEdge" Color="#80D9584B" />

  <SolidColorBrush x:Key="TagPurpleBg" Color="#2E9B7ED8" />
  <SolidColorBrush x:Key="TagPurpleEdge" Color="#809B7ED8" />

  <!-- tag 文字色（CSS 里是各色的深色变体，单独列出便于对照） -->
  <SolidColorBrush x:Key="TagGreenInk" Color="#FF4C8A30" />
  <SolidColorBrush x:Key="TagBlueInk" Color="#FF2E6E9E" />
  <SolidColorBrush x:Key="TagAmberInk" Color="#FFA9701A" />
  <SolidColorBrush x:Key="TagRedInk" Color="#FFB23A2E" />
  <SolidColorBrush x:Key="TagPurpleInk" Color="#FF6B4FB0" />

  <Style x:Key="PixelTagNeutralStyle" TargetType="Border"
         BasedOn="{StaticResource PixelTagStyle}">
    <Setter Property="Background" Value="{StaticResource TagNeutralBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource TagNeutralEdge}" />
  </Style>

  <Style x:Key="PixelTagGreenStyle" TargetType="Border"
         BasedOn="{StaticResource PixelTagStyle}">
    <Setter Property="Background" Value="{StaticResource TagGreenBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource TagGreenEdge}" />
  </Style>

  <Style x:Key="PixelTagBlueStyle" TargetType="Border"
         BasedOn="{StaticResource PixelTagStyle}">
    <Setter Property="Background" Value="{StaticResource TagBlueBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource TagBlueEdge}" />
  </Style>

  <Style x:Key="PixelTagAmberStyle" TargetType="Border"
         BasedOn="{StaticResource PixelTagStyle}">
    <Setter Property="Background" Value="{StaticResource TagAmberBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource TagAmberEdge}" />
  </Style>

  <Style x:Key="PixelTagRedStyle" TargetType="Border"
         BasedOn="{StaticResource PixelTagStyle}">
    <Setter Property="Background" Value="{StaticResource TagRedBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource TagRedEdge}" />
  </Style>

  <Style x:Key="PixelTagPurpleStyle" TargetType="Border"
         BasedOn="{StaticResource PixelTagStyle}">
    <Setter Property="Background" Value="{StaticResource TagPurpleBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource TagPurpleEdge}" />
  </Style>

  <!-- ==================================================================
       更新范围勾选项（CSS scope 类）

       scope: flex row, gap 10px; padding 12px 14px;
              border 2.5px solid 深棕; border-radius 6px;
              background 卡片色; box-shadow 0 3px 0 rgba(46,36,26,.10)
       scope.is-on → 边框转草绿深色; 背景转草绿光晕

       【实现选择：用 ToggleButton 自带模板，而非 CheckBox】
       CSS 的勾选框是 appearance:none 的自定义方块（17px，见勾号）。
       WinUI 的 CheckBox 模板改起来要动 Glyph 字体与颜色映射，
       而 ToggleButton 的 Checked 状态能直接驱动整个容器的
       边框色与背景色 —— 正好对上 .scope.is-on 的两处变化。
       勾号本身画成一个 17x17 的 Border + 两条 Rectangle（见 MainWindow.xaml）。
       ================================================================== -->
  <Style x:Key="PixelScopeStyle" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="Background" Value="{StaticResource BrushCard}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushEdge}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,12,14,12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Margin" Value="0,-2,0,0" />
                    <Setter Target="Shadow.Margin" Value="0,5,0,0" />
                    <Setter Target="Root.BorderBrush" Value="{StaticResource BrushGrassD}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Margin" Value="0,1,0,0" />
                    <Setter Target="Shadow.Margin" Value="0,2,0,0" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <!-- 勾选态独立分组：与 CommonStates 正交（CSS .scope.is-on） -->
              <!-- 【不能在这里设 CheckMark.Visibility】勾号在 ToggleButton 的
                   Content 里，而 VisualState 的 Setter Target 只在ControlTemplate
                   的命名空间内解析。两者不是同一棵树，指向模板外名字会在勾选态
                   生效时抛「找不到目标元素」。勾号改由 MainWindow 在
                   IsCheckedChanged 里直接控制 Visibility。 -->
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.BorderBrush" Value="{StaticResource BrushGrassD}" />
                    <Setter Target="Root.Background" Value="{StaticResource McGrassGlow}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="EnabledStates">
                <VisualState x:Name="Enabled" />
                <VisualState x:Name="Disabled">
                  <!-- CSS: 包里没有该项时 opacity:.45 + not-allowed -->
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.45" />
                    <Setter Target="Root.IsHitTestVisible" Value="False" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- 投影层：CSS box-shadow: 0 3px 0 rgba(46,36,26,.10) -->
            <Border x:Name="Shadow"
                    Background="{StaticResource BrushShadowList}"
                    CornerRadius="{StaticResource RadiusMd}"
                    Margin="0,3,0,0" />

            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 保护说明条（CSS .protected-note）
       background rgba(78,147,207,.10); border 2px solid rgba(78,147,207,.35);
       color ink-2；strong 用 #2E6E9E -->
  <SolidColorBrush x:Key="NoteBlueBg" Color="#1A4E93CF" />
  <SolidColorBrush x:Key="NoteBlueEdge" Color="#594E93CF" />

  <Style x:Key="ProtectedNoteStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource NoteBlueBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource NoteBlueEdge}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,10,14,10" />
  </Style>

  <!-- ==================================================================
       步骤 3 提示框（CSS .notice / .notice-warn / .notice-danger / .notice-info）

       padding 12px 16px; border-radius 6px; border 2px solid; font-size 13px
       三档各用「半透明底 + 半透明边 + 深色字」，与 tag 变体同一套做法。
       【为什么文字颜色不写进 Style】文字是子元素（TextBlock）的属性，
       Border 的 Style 只能管自己这层；颜色由 C# 侧逐条设置，
       与 CSS 里 .notice-warn { color: ... } 被后代继承的效果等价。
       ================================================================== -->
  <SolidColorBrush x:Key="NoteWarnBg" Color="#1FE0A83C" />
  <SolidColorBrush x:Key="NoteWarnEdge" Color="#73E0A83C" />
  <SolidColorBrush x:Key="NoteDangerBg" Color="#1FD9584B" />
  <SolidColorBrush x:Key="NoteDangerEdge" Color="#73D9584B" />
  <SolidColorBrush x:Key="NoteInfoBg" Color="#1F4E93CF" />
  <SolidColorBrush x:Key="NoteInfoEdge" Color="#664E93CF" />

  <Style x:Key="PixelNoticeWarnStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource NoteWarnBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource NoteWarnEdge}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,12,14,12" />
  </Style>

  <Style x:Key="PixelNoticeDangerStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource NoteDangerBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource NoteDangerEdge}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,12,14,12" />
  </Style>

  <Style x:Key="PixelNoticeInfoStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource NoteInfoBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource NoteInfoEdge}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,12,14,12" />
  </Style>

  <!-- 变更清单外框（CSS .changes）
       border 2.5px solid var(edge); border-radius 9px; background var(card);
       min-height 120px; box-shadow 0 4px 0 rgba(46,36,26,.10) -->
  <Style x:Key="PixelChangesBoxStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushCard}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushEdge}" />
    <Setter Property="BorderThickness" Value="{StaticResource ThinEdge}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="MinHeight" Value="120" />
  </Style>

  <!-- ==================================================================
       无外观切换按钮（变更行的勾选框用）

       【为什么要自己写模板】WinUI 的 Button / ToggleButton 默认模板在
       PointerOver / Pressed / Checked 各档都会改根 Grid 的 Background，
       而 VisualState 的 Setter 优先级高于本地赋值 —— 在代码里写
       Background="Transparent" 挡不住悬停时出现一层系统灰。
       像素风要的是"除了勾号什么都不变"，所以把四组视觉状态全部声明成空，
       只留 TemplateBinding 的背景。这是唯一干净的做法。
       ================================================================== -->
  <Style x:Key="PixelBareToggleStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="{TemplateBinding Background}">
            <ContentPresenter
                Content="{TemplateBinding Content}"
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked" />
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 变更行的分组头（CSS .group-head）
       padding 9px 16px; font-size 12px; font-weight 800;
       background var(card-2); border-bottom 2px solid var(line-soft) -->
  <Style x:Key="PixelGroupHeadStyle" TargetType="Grid">
    <Setter Property="Background" Value="{StaticResource BrushCard2}" />
  </Style>

  <!-- 键值信息行（CSS .kv）：grid-template-columns 78px 1fr; font-size 13px -->
  <!-- 【注意】KvLabelWidth 是 x:Double，不能喂给 ColumnDefinition.Width
       （那要GridLength）—— 编译全绿、运行期才抛 XamlParseException。
       MainWindow.xaml 里那一列因此写成字面量 78。保留此资源仅供
       C# 侧（如需要按列宽定位）引用。 -->
  <x:Double x:Key="KvLabelWidth">78</x:Double>
  <x:Double x:Key="KvFontSize">13</x:Double>

  <!-- ==================================================================
       遮罩层（CSS .overlay / .overlay-box）
       读包时盖住主体，显示进度。见 public/css/main.css 第 792~850 行。
       ================================================================== -->
  <SolidColorBrush x:Key="BrushOverlayScrim" Color="#B32E241A" />

  <Style x:Key="OverlayBoxStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushCard}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushEdge}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="28,24,28,24" />
    <Setter Property="Width" Value="440" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ==================================================================
       文本输入框（CSS input）
       border: 2.5px solid var(line); border-radius: 6px; background var(card)
       :focus → border-color var(grass-d); box-shadow: 0 0 0 3px var(grass-glow)
       ================================================================== -->
  <Style x:Key="PixelTextBoxStyle" TargetType="TextBox">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
    <Setter Property="Foreground" Value="{StaticResource BrushInk}" />
    <Setter Property="Background" Value="{StaticResource BrushCard}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushLine}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="10,7,10,7" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <!-- ==================================================================
       变更行（CSS .row）
       padding: 10px 16px; border-bottom: 2px solid var(line-soft)
       :hover → background rgba(232,193,112,.14)
       .is-unchecked .row-name → color var(ink-2)
       .is-unchanged → opacity .6

       【约束】不要改 ListViewItem 的 ControlTemplate —— WinUI 依赖它做
       选择/复选/键盘导航。行内样式靠 DataTrigger 或绑定选择器实现。
       ================================================================== -->
  <Style x:Key="ChangeRowBadgeStyle" TargetType="Border">
    <Setter Property="Width" Value="5" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ==================================================================
       滚动条加粗
       【决策】只加宽不改模板。ScrollBar 默认有 5 个 VisualState
       （PointerOver/Pressed/Dragging/Scrolling/TouchIndicator），
       漏一个就状态错乱 —— 加粗是 2 行改动，覆盖模板是 150 行且难调试。
       ================================================================== -->
  <x:Double x:Key="ScrollbarThickness">12</x:Double>

  <!-- ==================================================================
       进度条（CSS .upload-bar）
       height 14px; background var(edge-soft); border 2.5px solid var(edge);
       border-radius 4px; box-shadow: inset 0 2px 0 rgba(46,36,26,.08)
       ================================================================== -->
  <Style x:Key="PixelProgressBarStyle" TargetType="ProgressBar">
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource BrushGrass}" />
    <Setter Property="Background" Value="#FFE8DCC8" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushEdge}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
  </Style>
</ResourceDictionary>
